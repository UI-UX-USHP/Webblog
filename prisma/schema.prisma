// Prisma schema — SQLite cho weblog ushp.name.vn
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())

  posts Post[]
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique

  posts Post[]
}

model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String     @default("")
  contentHtml    String     @default("")
  coverImage     String?
  status         PostStatus @default(DRAFT)
  viewCount      Int        @default(0)
  readingMinutes Int        @default(1) // ước lượng thời gian đọc, tính lúc lưu
  featured       Boolean    @default(false) // ghim lên trang chủ
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  tags  PostTag[]
  views PostView[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

/// Gộp lượt xem theo ngày để vẽ biểu đồ thống kê.
model PostView {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  date   String // "YYYY-MM-DD"
  count  Int    @default(0)

  @@unique([postId, date])
  @@index([date])
}

/// Cấu hình key-value cho lớp Tích hợp (analytics, Giscus, script tùy chỉnh…).
model SiteSetting {
  key   String @id
  value String @default("")
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}
