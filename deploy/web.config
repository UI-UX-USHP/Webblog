<?xml version="1.0" encoding="UTF-8"?>
<!--
  Đặt file này vào thư mục gốc của Site IIS (vd: C:\inetpub\ushp-blog).
  Yêu cầu đã cài: URL Rewrite + Application Request Routing (ARR),
  và bật "Enable proxy" trong ARR ở cấp Server.

  Site IIS này KHÔNG chứa app Next.js — nó chỉ làm reverse proxy,
  chuyển mọi request về Next.js đang chạy ở http://127.0.0.1:26105.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNext" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:26105/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <!-- Cho phép WebSocket (Next.js dev/HMR & một số tính năng realtime) -->
    <webSocket enabled="true" />

    <!-- Tăng giới hạn upload để đăng ảnh bìa (khớp giới hạn 5MB trong app) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
